# Coolify > Environment Variables: kendi değerlerinizi burada tarif edildiği gibi girin.
# Şifre: yalnız Runtime açık; Build kapalı. Literal açık (özellikle $ karakteri için).
ADMIN_PASSWORD=

# Yalnız Runtime açık. Persistent Storage hedefi de /data olmalı.
DATA_DIR=/data

# Aşağıdaki üç değişkende Build ve Runtime açık. Değişince yeniden deploy gerekir.
# Gerçek HTTPS alan adı; sonunda yol veya eğik çizgi gerekmez. Demo için boş kalabilir.
NEXT_PUBLIC_SITE_URL=
# Gerçek WhatsApp hattı: uluslararası biçimde yalnız rakamlar (90...).
NEXT_PUBLIC_WHATSAPP_PHONE=905324291570
# Örnek ürünler kullanılırken false kalmalı; doğrulanmış içerik olmadan indeksleme açılmaz.
NEXT_PUBLIC_SITE_LIVE=false

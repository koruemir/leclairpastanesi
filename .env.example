# Leave empty during the sample-content phase.
NEXT_PUBLIC_SITE_URL=
# International WhatsApp number, digits only (for example the real business's 90... number).
NEXT_PUBLIC_WHATSAPP_PHONE=
# Indexing additionally requires verified business details and non-demo catalog data.
NEXT_PUBLIC_SITE_LIVE=false

# Server only. Set a unique administrator password before opening /admin.
ADMIN_PASSWORD=
# Local default: ./data. Coolify: /data with a persistent volume.
DATA_DIR=./data
